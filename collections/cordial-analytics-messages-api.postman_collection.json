          "id": "3d354146-dfd6-4d4d-b884-e33cefb427c0",
          "name": "Create a message report export job",
          "request": {
            "name": "Create a message report export job",
            "description": {
              "content": "Creates an export job to download and store a file of message analytics to an external location. The exported file can be downloaded via Cordial UI, FTP/SFTP, sent to Amazon S3 bucket, or sent to Google Cloud Storage bucket.<ul><li>Export status information is available through the jobs resource. To access the Jobs page via Cordial UI, click on the jobs icon at the top right of the application header.</li><li>Supported export file types are <b>CSV</b> and <b>JSON</b>.</li><li>Export files made available for download via the UI will be stored for 30 days from the export date.</li></ul>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "messageanalyticsexport"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
